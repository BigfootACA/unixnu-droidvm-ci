# Kernel configuration of the virtual machine board. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
# Console on the PL011 (patches/xnu/virt-pl011-uart.patch). The kernel is prelinked against the original kernelcache:
# the original corecrypto, AES and storage families start through OSKext, and NativeVirtioBlock (drivers/, virtio-mmio
# and virtio-pci) binds to the original IOBlockStorageDevice (scripts/data/storage-interface-audit.json).

CONFIG_XNU_SOURCE_CORECRYPTO14=y
# libpthread linked from source: the unprelinked kernel has no com.apple.kec.pthread.
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARMVIRT_PLATFORM=y
CONFIG_XNU_ARM_DT_PLATFORM=n
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# PAN on ARMv8.1+ (Kunpeng 920, SM8750): without it the kernel leaves SCTLR_EL1.SPAN clear, every exception sets
# PSTATE.PAN, and copyio to user memory faults forever (seen as a fast-fault loop once launchd runs). The ARMv8.0
# Hi1616 host (.52) therefore cannot run this kernel.
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_BOOT_PROGRESS=n
# The BCM2837 panic log at PA 0x3c0fc000 is PCIe MMIO on QEMU virt and unmapped on crosvm: take it from the ADT.
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
# The iOS root: trust caches at runtime, 4K page hashes of 16K code directories, and the owner verification chain
# (verified root probe -> mounted-root binding audit -> root acceptance -> SystemOS cache mount and dyld startup ->
# boot manifest). The OS and SystemOS disks are verified against the owner policies of scripts/make-virt-root.py.
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
# Let dyld map the shared cache from the authenticated SystemOS volume (neither the root nor a preboot volume here).
CONFIG_XNU_OWNER_CACHE_CARRIER=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
# Data: a volatile RAM disk (NativeRamBlock) seeded by DarwinBoot from the entry initrd (ci/scripts/make-data-seed.sh),
# mounted read-write at /private/var by the owner Data mount.
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
# The boot framebuffer as the original IOMobileFramebufferLegacy, copied by the CPU (drivers/NativeMobileDisplay,
# scripts/build-virt-display.py); the flag also enables the bsd_init and late IOKit hooks that start it.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="8748FE31-7E7F-4BFA-A7E2-7A4F5E14D0F6"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/native-virtio-block-verified-bundle/libNativeVirtioBlock.a"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
# NativeVirtioInput and its HID devices (scripts/build-virtio-input.py); nothing references them, so force_load.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/virtio-input/libVirtioInput.a -Wl,-force_load,{tree}/build/virt-stubs/libVirtStubs.a"
