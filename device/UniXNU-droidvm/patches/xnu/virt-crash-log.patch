--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -144,6 +144,74 @@ extern char     *proc_name_address(struct proc *p);
 TUNABLE_WRITEABLE(unsigned int, exception_log_max_pid, "exception_log_max_pid", 0);
 #endif /* (DEVELOPMENT || DEBUG) */
 
+/*
+ * Virtual machine boards: boot-arg crash-log=1 prints the user backtrace of a thread raising a fatal exception
+ * (bad access, bad instruction, arithmetic, breakpoint, guard, crash) with the slid shared cache base and the main
+ * image address, so that daemons dying with SIGTRAP or SIGABRT can be symbolized on the host.
+ */
+#if defined(__arm64__) && defined(MACH_BSD)
+#include <kern/backtrace.h>
+#include <vm/vm_shared_region.h>
+
+static TUNABLE(bool, virt_crash_log, "crash-log", false);
+
+#define VIRT_CRASH_FRAMES 48
+
+static void
+virt_crash_log_thread(exception_type_t exception, mach_exception_data_t code, mach_msg_type_number_t codeCnt,
+    thread_t thread)
+{
+	uintptr_t frames[VIRT_CRASH_FRAMES];
+	struct backtrace_user_info info = BTUINFO_INIT;
+	struct arm_saved_state *state;
+	vm_shared_region_t shared_region;
+	uint64_t cache_base = 0;
+	task_t task = current_task();
+	void *proc = get_bsdtask_info(task);
+	unsigned int count;
+	int pid = task_pid(task);
+	const char *name = proc ? proc_name_address(proc) : "?";
+
+	if (!virt_crash_log || thread != current_thread() || task == kernel_task) {
+		return;
+	}
+	switch (exception) {
+	case EXC_BAD_ACCESS:
+	case EXC_BAD_INSTRUCTION:
+	case EXC_ARITHMETIC:
+	case EXC_BREAKPOINT:
+	case EXC_GUARD:
+	case EXC_CRASH:
+		break;
+	default:
+		return;
+	}
+	shared_region = vm_shared_region_get(task);
+	if (shared_region != NULL) {
+		cache_base = shared_region->sr_base_address + shared_region->sr_first_mapping;
+		vm_shared_region_deallocate(shared_region);
+	}
+	state = find_user_regs(thread);
+	printf("crash: pid %d %s exc %d code 0x%llx 0x%llx cache 0x%llx main 0x%llx\n", pid, name, exception,
+	    (unsigned long long)(codeCnt > 0 ? code[0] : 0), (unsigned long long)(codeCnt > 1 ? code[1] : 0),
+	    (unsigned long long)cache_base, (unsigned long long)task->mach_header_vm_address);
+	if (state != NULL) {
+		printf("crash: pid %d pc 0x%llx lr 0x%llx sp 0x%llx fp 0x%llx far 0x%llx esr 0x%x\n", pid,
+		    (unsigned long long)get_saved_state_pc(state), (unsigned long long)get_saved_state_lr(state),
+		    (unsigned long long)get_saved_state_sp(state), (unsigned long long)get_saved_state_fp(state),
+		    (unsigned long long)get_saved_state_far(state), get_saved_state_esr(state));
+	}
+	count = backtrace_user(frames, VIRT_CRASH_FRAMES, NULL, &info);
+	for (unsigned int i = 0; i < count; i += 4) {
+		printf("crash: pid %d #%u 0x%lx 0x%lx 0x%lx 0x%lx\n", pid, i, frames[i],
+		    i + 1 < count ? frames[i + 1] : 0, i + 2 < count ? frames[i + 2] : 0, i + 3 < count ? frames[i + 3] : 0);
+	}
+	if (info.btui_error != 0) {
+		printf("crash: pid %d backtrace error %d after %u frames\n", pid, info.btui_error, count);
+	}
+}
+#endif /* __arm64__ && MACH_BSD */
+
 /*
  * Routine: exception_init
  * Purpose:
@@ -659,6 +727,10 @@ exception_triage_thread(
 
 	assert(exception != EXC_RPC_ALERT);
 
+#if defined(__arm64__) && defined(MACH_BSD)
+	virt_crash_log_thread(exception, code, codeCnt, thread);
+#endif /* __arm64__ && MACH_BSD */
+
 	/*
 	 * If this behavior has been requested by the the kernel
 	 * (due to the boot environment), we should panic if we
