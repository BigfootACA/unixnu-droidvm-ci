diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index 715c545..eb3f7de 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -137,6 +137,10 @@ uint32_t cons_ops_index = VC_CONS_OPS;
 SECURITY_READ_ONLY_LATE(uint32_t) cons_ops_index = VC_CONS_OPS;
 #endif
 
+/* UniXNU virt boards (vc-text=1): also write each console character to the other console. */
+extern bool console_mirror;
+bool console_mirror = false;
+
 LCK_GRP_DECLARE(console_lck_grp, "console");
 
 /* If the NMI string is entered into the console, the system will enter the debugger. */
@@ -263,6 +267,9 @@ _cnputc(char c, bool poll)
 	}
 
 	cons_ops[idx].putc(c, poll);
+	if (console_mirror) {
+		cons_ops[idx == SERIAL_CONS_OPS ? VC_CONS_OPS : SERIAL_CONS_OPS].putc(c, poll);
+	}
 }
 
 /**
diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index f3532cc..8d50780 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -534,10 +534,20 @@ PE_create_console(void)
 	 */
 	check_for_panic_log();
 
-	if (PE_state.video.v_display) {
+	/*
+	 * UniXNU virt boards: vc-text=1 draws the console as text on the boot framebuffer and mirrors it with the
+	 * serial console. v_display stays set, so a display driver can still take the framebuffer over later.
+	 */
+	uint32_t vc_text = 0;
+	PE_parse_boot_argn("vc-text", &vc_text, sizeof(vc_text));
+	if (PE_state.video.v_display && !vc_text) {
 		PE_initialize_console(&PE_state.video, kPEGraphicsMode);
 	} else {
 		PE_initialize_console(&PE_state.video, kPETextMode);
+		if (vc_text) {
+			extern bool console_mirror;
+			console_mirror = true;
+		}
 	}
 }
 
